{
    "name": "artisan-build/pusher-websocket-php",
    "description": "Pusher Channels websocket client library for PHP",
    "keywords": [
        "pusher",
        "websocket",
        "realtime"
    ],
    "homepage": "https://github.com/artisan-build/pusher-websocket-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Len Woodward",
            "email": "Len@ProjektGopher.com",
            "role": "Co-Founder"
        },
        {
            "name": "Ed Grosvenor",
            "email": "Ed@Gros.co",
            "role": "Co-Founder"
        }
    ],
    "require": {
        "php": "^8.3",
        "ratchet/pawl": "^0.4.1",
        "react/async": "^4.3",
        "react/event-loop": "^1.5",
        "react/promise": "^3.2",
        "react/promise-timer": "^1.11"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0||^4.0",
        "pestphp/pest-plugin-arch": "^3.0||^4.0",
        "pestphp/pest-plugin-type-coverage": "^3.2||^4.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ArtisanBuild\\Pusher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArtisanBuild\\Pusher\\Tests\\": "tests/"
        },
        "files": [
            "tests/Helpers.php"
        ]
    },
    "scripts": {
        "stan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --exclude-group=integration",
        "test:integration": "vendor/bin/pest --group=integration",
        "test:all": "vendor/bin/pest",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage --min=66",
        "test:types": "vendor/bin/pest --type-coverage --min=100",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
